{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eggstock",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
