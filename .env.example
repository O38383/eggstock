# Discord bot token (from Discord Developer Portal, YOUR bot, not SenZ V2's)
DISCORD_TOKEN=your_bot_token_here

# Right-click the #stock-notify channel in Discord (Developer Mode on) -> Copy Channel ID
STOCK_NOTIFY_CHANNEL_ID=123456789012345678

# Right-click the #last-stock-notify channel -> Copy Channel ID
LAST_SEEN_CHANNEL_ID=123456789012345678

# Optional: right-click SenZ V2 in your member list -> Copy User ID
# Leave blank to accept spawn embeds from any bot in the channel
SENZ_BOT_USER_ID=

# Optional: how many recent observed gaps feed the median wave estimate
GAP_WINDOW_SIZE=20

# Optional: temporary wave estimate until real gap data arrives
FALLBACK_INTERVAL_SECONDS=300

# Port Railway will inject automatically - safe to leave as is
PORT=8080

# Auto-assign basic role on member join
# Name of the role to give (default: Member)
AUTO_ASSIGN_ROLE_NAME=Member
# Or specify the exact Role ID (optional):
# AUTO_ASSIGN_ROLE_ID=123456789012345678
